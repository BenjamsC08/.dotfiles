[global_config]
  inactive_color_offset = 0.8578125
[keybindings]
  go_up = <Alt>KP_8
  go_down = <Alt>KP_2
  go_left = <Alt>KP_4
  go_right = <Alt>KP_6
  toggle_scrollbar = ""
  search = ""
  toggle_zoom = ""
  scaled_zoom = ""
  hide_window = ""
  ungroup_all = ""
  group_tab_toggle = F12
  ungroup_tab = ""
  broadcast_off = <Primary><Shift><Alt>a
  broadcast_all = <Primary><Alt>a
  insert_number = ""
  insert_padded = ""
  edit_tab_title = ""
  help = KP_Subtract
[profiles]
  [[default]]
    background_color = "#282828"
    cursor_shape = ibeam
    font = 0xProto Nerd Font Mono 10
    foreground_color = "#ebdbb2"
    scrollbar_position = hidden
    scrollback_lines = 1500
    scrollback_infinite = True
    use_system_font = False
  [[transparent]]
    background_type = transparent
    cursor_shape = ibeam
    font = 0xProto Nerd Font Mono 10
    foreground_color = "#00ff00"
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
