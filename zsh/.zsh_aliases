# Compile
alias gcf="cc -Wall -Wextra -Werror -O"
alias gcd="cc -g3 -O0"
alias vg="valgrind --leak-check=full --track-origins=yes -s"
alias objdump="objdump -M intel -D"
# Utils
alias bmake="bear -- make"

if command -v batcat >/dev/null 2>&1; then
  alias bat="batcat"
fi

if command -v nvim >/dev/null 2>&1; then
  alias vi="nvim"
  alias v="nvim"
fi
